{
  "name": "evidence-gated-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Orquestrador determinístico que transforma solicitações aprovadas em branches revisáveis por um agente de IA headless — o push só acontece com evidência objetiva.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "poll": "tsx src/cli.ts poll",
    "status": "tsx src/cli.ts status",
    "retry": "tsx src/cli.ts retry",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:container": "vitest run --config vitest.container.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
